  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_anon_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{supabase_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token?grant_type=password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"YOUR_EMAIL\",\"password\":\"YOUR_PASSWORD\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var j=pm.response.json();if(j.access_token){pm.collectionVariables.set('auth_token',j.access_token);pm.collectionVariables.set('user_id',j.user.id);}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
